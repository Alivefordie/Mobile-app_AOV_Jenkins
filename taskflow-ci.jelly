<?jelly escape-by-default='true'?>

<j:jelly xmlns:j="jelly:core"
         xmlns:st="jelly:stapler"
         xmlns:d="jelly:define">

  <j:set var="result" value="${build.result}" />

  <j:choose>
    <j:when test="${result == 'SUCCESS'}">
      <j:set var="statusColor" value="#16a34a" />
      <j:set var="statusBg" value="#dcfce7" />
      <j:set var="statusText" value="SUCCESS" />
      <j:set var="statusIcon" value="✓" />
    </j:when>

    <j:when test="${result == 'FAILURE'}">
      <j:set var="statusColor" value="#dc2626" />
      <j:set var="statusBg" value="#fee2e2" />
      <j:set var="statusText" value="FAILED" />
      <j:set var="statusIcon" value="✕" />
    </j:when>

    <j:when test="${result == 'UNSTABLE'}">
      <j:set var="statusColor" value="#d97706" />
      <j:set var="statusBg" value="#fef3c7" />
      <j:set var="statusText" value="UNSTABLE" />
      <j:set var="statusIcon" value="!" />
    </j:when>

    <j:when test="${result == 'ABORTED'}">
      <j:set var="statusColor" value="#6b7280" />
      <j:set var="statusBg" value="#f3f4f6" />
      <j:set var="statusText" value="ABORTED" />
      <j:set var="statusIcon" value="■" />
    </j:when>

    <j:otherwise>
      <j:set var="statusColor" value="#2563eb" />
      <j:set var="statusBg" value="#dbeafe" />
      <j:set var="statusText" value="${result}" />
      <j:set var="statusIcon" value="•" />
    </j:otherwise>
  </j:choose>

  <html>
    <body style="margin:0;padding:0;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">

      <table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6f8;padding:24px;">
        <tr>
          <td align="center">

            <table width="680" cellpadding="0" cellspacing="0"
                   style="width:100%;max-width:680px;background:#ffffff;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;">

              <!-- Header -->
              <tr>
                <td style="background:#111827;padding:24px 28px;color:#ffffff;">
                  <div style="font-size:12px;opacity:.75;margin-bottom:6px;">
                    Jenkins CI/CD
                  </div>

                  <div style="font-size:24px;font-weight:700;">
                    ${project.name}
                  </div>

                  <div style="font-size:14px;margin-top:6px;opacity:.85;">
                    Build #${build.number}
                  </div>
                </td>
              </tr>

              <!-- Status badge -->
              <tr>
                <td style="padding:24px 28px 10px 28px;">

                  <span style="
                    display:inline-block;
                    padding:7px 14px;
                    border-radius:999px;
                    background:${statusBg};
                    color:${statusColor};
                    font-size:13px;
                    font-weight:700;
                  ">
                    ${statusIcon} ${statusText}
                  </span>

                </td>
              </tr>

              <!-- Info -->
              <tr>
                <td style="padding:10px 28px 24px 28px;">

                  <table width="100%" cellpadding="0" cellspacing="0"
                         style="border-collapse:collapse;font-size:14px;">

                    <tr>
                      <td style="width:150px;padding:11px 0;color:#6b7280;border-bottom:1px solid #eeeeee;">
                        Job
                      </td>
                      <td style="padding:11px 0;font-weight:600;border-bottom:1px solid #eeeeee;">
                        ${project.fullDisplayName}
                      </td>
                    </tr>

                    <tr>
                      <td style="padding:11px 0;color:#6b7280;border-bottom:1px solid #eeeeee;">
                        Branch
                      </td>
                      <td style="padding:11px 0;font-weight:600;border-bottom:1px solid #eeeeee;">
                        ${build.getEnvironment(listener).get('BRANCH_NAME')}
                      </td>
                    </tr>

                    <tr>
                      <td style="padding:11px 0;color:#6b7280;border-bottom:1px solid #eeeeee;">
                        Build
                      </td>
                      <td style="padding:11px 0;font-weight:600;border-bottom:1px solid #eeeeee;">
                        #${build.number}
                      </td>
                    </tr>

                    <tr>
                      <td style="padding:11px 0;color:#6b7280;border-bottom:1px solid #eeeeee;">
                        Status
                      </td>
                      <td style="padding:11px 0;font-weight:700;color:${statusColor};border-bottom:1px solid #eeeeee;">
                        ${statusText}
                      </td>
                    </tr>

                  <tr>
                    <td style="padding:11px 0;color:#6b7280;border-bottom:1px solid #eeeeee;">
                      Commit
                    </td>
                    <td style="padding:11px 0;border-bottom:1px solid #eeeeee;">
                      <div style="font-family:Consolas,Monaco,monospace;font-weight:600;">
                        ${build.getEnvironment(listener).get('COMMIT_SHA')}
                      </div>
                      <div style="margin-top:4px;color:#6b7280;font-size:12px;">
                        ${build.getEnvironment(listener).get('COMMIT_MESSAGE')}
                      </div>
                    </td>
                  </tr>

                    <tr>
                      <td style="padding:11px 0;color:#6b7280;border-bottom:1px solid #eeeeee;">
                        Failed Stage
                      </td>
                      <td style="padding:11px 0;font-weight:600;border-bottom:1px solid #eeeeee;">
                        ${build.getEnvironment(listener).get('STAGE_NAME')}
                      </td>
                    </tr>

                  </table>

                  <div style="margin-top:26px;">

                    <a href="${rooturl}${build.url}"
                       style="
                         display:inline-block;
                         background:#2563eb;
                         color:#ffffff;
                         text-decoration:none;
                         padding:12px 20px;
                         border-radius:7px;
                         font-size:14px;
                         font-weight:700;
                       ">
                      View Jenkins Build →
                    </a>

                  </div>

                </td>
              </tr>

              <!-- Footer -->
              <tr>
                <td style="padding:16px 28px;background:#f9fafb;border-top:1px solid #e5e7eb;color:#6b7280;font-size:12px;line-height:1.5;">
                  Automated notification from Jenkins.<br/>
                  ${rooturl}${build.url}
                </td>
              </tr>

            </table>

          </td>
        </tr>
      </table>

    </body>
  </html>

</j:jelly>